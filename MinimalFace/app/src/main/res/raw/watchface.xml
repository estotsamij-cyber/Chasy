<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <UserConfigurations>
        <ColorConfiguration id="accent" displayName="cfg_accent" defaultValue="1">
            <ColorOption id="0" displayName="c_blue" colors="#2F7BFF" />
            <ColorOption id="1" displayName="c_orange" colors="#FF9500" />
            <ColorOption id="2" displayName="c_green" colors="#34C759" />
            <ColorOption id="3" displayName="c_red" colors="#FF3B30" />
            <ColorOption id="4" displayName="c_white" colors="#FFFFFF" />
        </ColorConfiguration>

        <ColorConfiguration id="digits" displayName="cfg_digits" defaultValue="0">
            <ColorOption id="0" displayName="c_white" colors="#FFFFFF" />
            <ColorOption id="1" displayName="c_gray" colors="#8E8E93" />
            <ColorOption id="2" displayName="c_yellow" colors="#FFD60A" />
        </ColorConfiguration>

        <ColorConfiguration id="bg" displayName="cfg_bg" defaultValue="0">
            <ColorOption id="0" displayName="c_black" colors="#000000" />
            <ColorOption id="1" displayName="c_dgray" colors="#141414" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- Фон -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.bg]">
                    <Variant mode="AMBIENT" target="color" value="#000000" />
                </Fill>
            </Rectangle>
        </PartDraw>

        <Group x="0" y="0" width="450" height="450" name="live">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- Левая дуга (Шаги) -->
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="210" endAngle="330">
                    <Stroke color="#33808080" thickness="10" cap="ROUND" />
                </Arc>
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="210" endAngle="210">
                    <Transform target="endAngle" value="210 + (clamp([STEP_PERCENT], 0, 100) * 1.2)" />
                    <Stroke color="[CONFIGURATION.accent]" thickness="10" cap="ROUND" />
                </Arc>
            </PartDraw>

            <!-- Правая дуга (Батарея) -->
            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="150" endAngle="30" direction="COUNTER_CLOCKWISE">
                    <Stroke color="#33808080" thickness="10" cap="ROUND" />
                </Arc>
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="150" endAngle="150" direction="COUNTER_CLOCKWISE">
                    <Transform target="endAngle" value="150 - (clamp([BATTERY_PERCENT], 0, 100) * 1.2)" />
                    <Stroke color="[CONFIGURATION.accent]" thickness="10" cap="ROUND" />
                </Arc>
            </PartDraw>

            <!-- Рамка погоды и кружки приложений -->
            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="105" y="222" width="240" height="34" cornerRadiusX="17" cornerRadiusY="17">
                    <Stroke color="[CONFIGURATION.accent]" thickness="2" />
                </RoundRectangle>
                <Ellipse x="88" y="306" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="160" y="306" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="232" y="306" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="304" y="306" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
            </PartDraw>

            <!-- Текст шагов слева сверху -->
            <PartText x="50" y="112" width="130" height="30">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.accent]">
                        <Template>👟 %d<Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <!-- Текст батареи справа сверху -->
            <PartText x="270" y="112" width="130" height="30">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.accent]">
                        <Template>🔋 %d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <!-- Пульс -->
            <PartText x="125" y="262" width="200" height="34">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="28" color="[CONFIGURATION.digits]">
                        <Template>♥ %d<Parameter expression="round([HEART_RATE])" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Дата -->
        <PartText x="75" y="58" width="300" height="34">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" color="[CONFIGURATION.accent]">
                    <Template>%s, %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Цифровые часы -->
        <DigitalClock x="0" y="92" width="450" height="124">
            <TimeText x="0" y="0" width="450" height="124" format="hh:mm" hourFormat="TWENTY_FOUR" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="112" weight="NORMAL" color="[CONFIGURATION.digits]">
                    <Variant mode="AMBIENT" target="color" value="#FFFFFF" />
                </Font>
            </TimeText>
        </DigitalClock>

        <!-- Слоты быстрых приложений -->
        <ComplicationSlot slotId="0" name="app1" displayName="slot_app1" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="88" y="306" width="58" height="58">
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="1" name="app2" displayName="slot_app2" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="160" y="306" width="58" height="58">
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="2" name="app3" displayName="slot_app3" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="232" y="306" width="58" height="58">
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="3" name="app4" displayName="slot_app4" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="304" y="306" width="58" height="58">
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
