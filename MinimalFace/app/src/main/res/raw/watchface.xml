<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <UserConfigurations>
        <ColorConfiguration id="accent" displayName="cfg_accent" defaultValue="1">
            <ColorOption id="0" displayName="c_navy" colors="#1F3FA8" />
            <ColorOption id="1" displayName="c_blue" colors="#2F7BFF" />
            <ColorOption id="2" displayName="c_lblue" colors="#6EC6FF" />
            <ColorOption id="3" displayName="c_teal" colors="#19D3C5" />
            <ColorOption id="4" displayName="c_dgreen" colors="#11804F" />
            <ColorOption id="5" displayName="c_green" colors="#34C759" />
            <ColorOption id="6" displayName="c_lime" colors="#B7E34A" />
            <ColorOption id="7" displayName="c_yellow" colors="#FFD60A" />
            <ColorOption id="8" displayName="c_orange" colors="#FF9500" />
            <ColorOption id="9" displayName="c_red" colors="#FF3B30" />
            <ColorOption id="10" displayName="c_pink" colors="#FF5FA2" />
            <ColorOption id="11" displayName="c_violet" colors="#9B6BFF" />
            <ColorOption id="12" displayName="c_white" colors="#FFFFFF" />
            <ColorOption id="13" displayName="c_gray" colors="#8E8E93" />
        </ColorConfiguration>

        <ColorConfiguration id="digits" displayName="cfg_digits" defaultValue="0">
            <ColorOption id="0" displayName="c_white" colors="#FFFFFF" />
            <ColorOption id="1" displayName="c_lgray" colors="#D1D1D6" />
            <ColorOption id="2" displayName="c_blue" colors="#8FB8FF" />
            <ColorOption id="3" displayName="c_lblue" colors="#6EC6FF" />
            <ColorOption id="4" displayName="c_green" colors="#7DF0C2" />
            <ColorOption id="5" displayName="c_lime" colors="#B7E34A" />
            <ColorOption id="6" displayName="c_yellow" colors="#FFD60A" />
            <ColorOption id="7" displayName="c_orange" colors="#FF9500" />
            <ColorOption id="8" displayName="c_pink" colors="#FF8FC2" />
            <ColorOption id="9" displayName="c_black" colors="#000000" />
        </ColorConfiguration>

        <ColorConfiguration id="bg" displayName="cfg_bg" defaultValue="0">
            <ColorOption id="0" displayName="c_black" colors="#000000" />
            <ColorOption id="1" displayName="c_dgray" colors="#141414" />
            <ColorOption id="2" displayName="c_dnavy" colors="#0A1630" />
            <ColorOption id="3" displayName="c_dforest" colors="#0A2218" />
            <ColorOption id="4" displayName="c_white" colors="#FFFFFF" />
        </ColorConfiguration>

        <ListConfiguration id="weather_mode" displayName="cfg_weather" defaultValue="0">
            <ListOption id="0" displayName="w_temp" />
            <ListOption id="1" displayName="w_rain" />
            <ListOption id="2" displayName="w_uv" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.bg]">
                    <Variant mode="AMBIENT" target="color" value="#000000" />
                </Fill>
            </Rectangle>
        </PartDraw>

        <Group x="0" y="0" width="450" height="450" name="live">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw x="0" y="0" width="450" height="450">
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="220" endAngle="320">
                    <Stroke color="#33808080" thickness="10" cap="ROUND" />
                </Arc>
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="220" endAngle="220">
                    <Transform target="endAngle" value="220 + clamp([STEP_PERCENT], 0, 100)" />
                    <Stroke color="[CONFIGURATION.accent]" thickness="10" cap="ROUND" />
                </Arc>
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="40" endAngle="140">
                    <Stroke color="#33808080" thickness="10" cap="ROUND" />
                </Arc>
                <Arc centerX="225" centerY="225" width="430" height="430" startAngle="140" endAngle="140" direction="COUNTER_CLOCKWISE">
                    <Transform target="endAngle" value="140 - clamp([BATTERY_PERCENT], 0, 100)" />
                    <Stroke color="[CONFIGURATION.accent]" thickness="10" cap="ROUND" />
                </Arc>
            </PartDraw>

            <PartDraw x="0" y="0" width="450" height="450">
                <RoundRectangle x="105" y="232" width="240" height="32" cornerRadiusX="16" cornerRadiusY="16">
                    <Stroke color="[CONFIGURATION.accent]" thickness="2" />
                </RoundRectangle>
                <Ellipse x="88" y="304" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="160" y="304" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="232" y="304" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
                <Ellipse x="304" y="304" width="58" height="58">
                    <Stroke color="[CONFIGURATION.accent]" thickness="3" />
                </Ellipse>
            </PartDraw>

            <Condition>
                <Expressions>
                    <Expression name="weather_ok">[WEATHER.IS_AVAILABLE]</Expression>
                </Expressions>
                <Compare expression="weather_ok">
                    <ListConfiguration id="weather_mode">
                        <ListOption id="0">
                            <PartText x="105" y="232" width="240" height="32">
                                <Text align="CENTER" ellipsis="TRUE">
                                    <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.digits]">
                                        <Template>%d° %s<Parameter expression="round([WEATHER.TEMPERATURE])" /><Parameter expression="[WEATHER.CONDITION_NAME]" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </ListOption>
                        <ListOption id="1">
                            <PartText x="105" y="232" width="240" height="32">
                                <Text align="CENTER" ellipsis="TRUE">
                                    <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.digits]">
                                        <Template>Осадки %d%%<Parameter expression="round([WEATHER.CHANCE_OF_PRECIPITATION])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </ListOption>
                        <ListOption id="2">
                            <PartText x="105" y="232" width="240" height="32">
                                <Text align="CENTER" ellipsis="TRUE">
                                    <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.digits]">
                                        <Template>УФ-индекс %d<Parameter expression="round([WEATHER.UV_INDEX])" /></Template>
                                    </Font>
                                </Text>
                            </PartText>
                        </ListOption>
                    </ListConfiguration>
                </Compare>
                <Default>
                    <PartText x="105" y="232" width="240" height="32">
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.digits]">
                                <![CDATA[—]]>
                            </Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>

            <PartText x="100" y="44" width="110" height="28">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.accent]">
                        <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText x="240" y="44" width="110" height="28">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="18" color="[CONFIGURATION.accent]">
                        <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText x="125" y="268" width="200" height="32">
                <Text align="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="26" color="[CONFIGURATION.digits]">
                        <Template>♥ %d<Parameter expression="round([HEART_RATE])" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <PartText x="75" y="82" width="300" height="32">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.accent]">
                    <Template>%s, %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <DigitalClock x="0" y="112" width="450" height="112">
            <TimeText x="0" y="0" width="450" height="112" format="hh:mm" hourFormat="TWENTY_FOUR" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="100" weight="NORMAL" color="[CONFIGURATION.digits]">
                    <Variant mode="AMBIENT" target="color" value="#FFFFFF" />
                </Font>
            </TimeText>
        </DigitalClock>

        <ComplicationSlot slotId="0" name="app1" displayName="slot_app1" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="88" y="304" width="58" height="58">
            <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" tintColor="[CONFIGURATION.digits]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="1" name="app2" displayName="slot_app2" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="160" y="304" width="58" height="58">
            <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" tintColor="[CONFIGURATION.digits]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="2" name="app3" displayName="slot_app3" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="232" y="304" width="58" height="58">
            <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" tintColor="[CONFIGURATION.digits]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
        <ComplicationSlot slotId="3" name="app4" displayName="slot_app4" supportedTypes="MONOCHROMATIC_IMAGE SMALL_IMAGE" x="304" y="304" width="58" height="58">
            <DefaultProviderPolicy defaultSystemProvider="APP_SHORTCUT" defaultSystemProviderType="MONOCHROMATIC_IMAGE" />
            <BoundingOval x="0" y="0" width="58" height="58" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="13" y="13" width="32" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" tintColor="[CONFIGURATION.digits]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="42" height="42">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
